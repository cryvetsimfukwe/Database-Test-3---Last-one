(b) Function: fn_loan_balance [6 marks]

CREATE OR REPLACE FUNCTION fn_loan_balance(
    p_loan_id INTEGER
) RETURNS NUMERIC(12, 2)
LANGUAGE plpgsql
AS $$
DECLARE
    v_principal  NUMERIC(12, 2);
    v_total_paid NUMERIC(12, 2);
BEGIN
    SELECT principal INTO v_principal
    FROM loan_accounts
    WHERE loan_id = p_loan_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Loan ID % does not exist.', p_loan_id;
    END IF;

    SELECT COALESCE(SUM(amount), 0.00) INTO v_total_paid
    FROM repayments
    WHERE loan_id = p_loan_id;

    RETURN v_principal - v_total_paid;
END;
$$;



(c) Procedure: pr_post_repayment [8 marks]


CREATE OR REPLACE PROCEDURE pr_post_repayment(
    p_loan_id INTEGER,
    p_amount  NUMERIC(12, 2),
    p_paid_on DATE
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_status  VARCHAR(20);
    v_balance NUMERIC(12, 2);
BEGIN
    IF p_amount IS NULL OR p_amount <= 0 THEN
        RAISE EXCEPTION 'Repayment amount must be greater than zero.';
    END IF;

    IF p_paid_on IS NULL THEN
        RAISE EXCEPTION 'Repayment date cannot be NULL.';
    END IF;

    -- Lock loan account row to prevent concurrent overpayments
    SELECT status INTO v_status
    FROM loan_accounts
    WHERE loan_id = p_loan_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown loan_id: %', p_loan_id;
    END IF;

    IF v_status = 'SETTLED' THEN
        RAISE EXCEPTION 'Loan ID % is already SETTLED and cannot accept further repayments.', p_loan_id;
    END IF;

    v_balance := fn_loan_balance(p_loan_id);

    IF p_amount > v_balance THEN
        RAISE EXCEPTION 'Repayment of % exceeds remaining balance of % for loan_id %.',
            p_amount, v_balance, p_loan_id;
    END IF;

    -- Insert valid repayment
    INSERT INTO repayments (loan_id, amount, paid_on)
    VALUES (p_loan_id, p_amount, p_paid_on);

    -- If remaining balance reaches zero, mark loan as SETTLED
    IF (v_balance - p_amount) = 0 THEN
        UPDATE loan_accounts
        SET status = 'SETTLED'
        WHERE loan_id = p_loan_id;
    END IF;
END;
$$;


(d) Trigger: trg_repayments_audit [8 marks]

CREATE OR REPLACE FUNCTION fn_log_repayment_audit()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    INSERT INTO repayment_audit (repayment_id, loan_id, amount, logged_at)
    VALUES (NEW.repayment_id, NEW.loan_id, NEW.amount, CURRENT_TIMESTAMP);
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_repayments_audit
AFTER INSERT ON repayments
FOR EACH ROW
EXECUTE FUNCTION fn_log_repayment_audit();

