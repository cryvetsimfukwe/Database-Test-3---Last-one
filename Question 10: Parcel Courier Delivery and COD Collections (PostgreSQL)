Question 10: Parcel Courier Delivery and COD Collections (PostgreSQL)


(a) Database and Seed Data [6 marks]

CREATE TABLE couriers (
    courier_id   SERIAL PRIMARY KEY,
    courier_name VARCHAR(100) NOT NULL
);

CREATE TABLE parcels (
    parcel_id    SERIAL PRIMARY KEY,
    courier_id   INTEGER NOT NULL REFERENCES couriers(courier_id),
    tracking_no  VARCHAR(30) NOT NULL UNIQUE,
    cod_amount   NUMERIC(10, 2) NOT NULL CHECK (cod_amount >= 0),
    status       VARCHAR(20) NOT NULL DEFAULT 'IN_TRANSIT'
                 CHECK (status IN ('IN_TRANSIT', 'DELIVERED', 'RETURNED')),
    delivered_on DATE NULL
);

CREATE TABLE cod_collections (
    collection_id SERIAL PRIMARY KEY,
    parcel_id     INTEGER NOT NULL UNIQUE REFERENCES parcels(parcel_id),
    amount        NUMERIC(10, 2) NOT NULL CHECK (amount > 0),
    collected_on  DATE NOT NULL DEFAULT CURRENT_DATE
);

CREATE TABLE daily_cod (
    cod_date        DATE PRIMARY KEY,
    parcel_count    INTEGER NOT NULL DEFAULT 0,
    total_collected NUMERIC(12, 2) NOT NULL DEFAULT 0.00
);

