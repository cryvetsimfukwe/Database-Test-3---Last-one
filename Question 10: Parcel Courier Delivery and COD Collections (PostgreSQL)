(g) Scheduled Job: pr_refresh_cod [6 marks]

CREATE OR REPLACE PROCEDURE pr_refresh_cod(p_day DATE)
LANGUAGE plpgsql
AS $$
DECLARE
    v_count INTEGER;
    v_total NUMERIC(12, 2);
BEGIN
    SELECT
        COUNT(*),
        COALESCE(SUM(amount), 0.00)
    INTO v_count, v_total
    FROM cod_collections
    WHERE collected_on = p_day;

    INSERT INTO daily_cod (cod_date, parcel_count, total_collected)
    VALUES (p_day, v_count, v_total)
    ON CONFLICT (cod_date)
    DO UPDATE SET
        parcel_count    = EXCLUDED.parcel_count,
        total_collected = EXCLUDED.total_collected;
END;
$$;

-- Schedule daily at 01:00 for the previous day using pg_cron
CREATE EXTENSION IF NOT EXISTS pg_cron;

SELECT cron.schedule(
    'refresh_previous_day_cod',
    '0 1 * * *',
    $$CALL pr_refresh_cod((CURRENT_DATE - INTERVAL '1 day')::DATE);$$
);



