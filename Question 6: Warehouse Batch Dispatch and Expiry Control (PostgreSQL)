(b) Function: fn_days_to_expiry [6 marks]

CREATE OR REPLACE FUNCTION fn_days_to_expiry(
    p_batch_id   INTEGER,
    p_as_of_date DATE DEFAULT CURRENT_DATE
) RETURNS INTEGER
LANGUAGE plpgsql
AS $$
DECLARE
    v_expiry_date DATE;
BEGIN
    IF p_as_of_date IS NULL THEN
        RAISE EXCEPTION 'Reference date (p_as_of_date) cannot be NULL.';
    END IF;

    SELECT expiry_date INTO v_expiry_date
    FROM batches
    WHERE batch_id = p_batch_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Batch ID % does not exist.', p_batch_id;
    END IF;

    RETURN v_expiry_date - p_as_of_date;
END;
$$;


(c) Procedure: pr_dispatch_batch [8 marks]

CREATE OR REPLACE PROCEDURE pr_dispatch_batch(
    p_batch_id      INTEGER,
    p_qty           INTEGER,
    p_dispatched_on DATE
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_expiry_date DATE;
    v_qty_on_hand INTEGER;
BEGIN
    IF p_qty IS NULL OR p_qty <= 0 THEN
        RAISE EXCEPTION 'Dispatch quantity must be greater than zero.';
    END IF;

    IF p_dispatched_on IS NULL THEN
        RAISE EXCEPTION 'Dispatch date cannot be NULL.';
    END IF;

    -- Lock batch row to prevent concurrent over-dispatching
    SELECT expiry_date, qty_on_hand
    INTO v_expiry_date, v_qty_on_hand
    FROM batches
    WHERE batch_id = p_batch_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown batch_id: %', p_batch_id;
    END IF;

    IF v_expiry_date <= p_dispatched_on THEN
        RAISE EXCEPTION 'Cannot dispatch expired batch ID % (expiry_date: %, dispatched_on: %).',
            p_batch_id, v_expiry_date, p_dispatched_on;
    END IF;

    IF v_qty_on_hand < p_qty THEN
        RAISE EXCEPTION 'Insufficient stock in batch ID %. Available: %, Requested: %',
            p_batch_id, v_qty_on_hand, p_qty;
    END IF;

    -- Record dispatch and deduct quantity once
    INSERT INTO dispatches (batch_id, qty_dispatched, dispatched_on)
    VALUES (p_batch_id, p_qty, p_dispatched_on);

    UPDATE batches
    SET qty_on_hand = qty_on_hand - p_qty
    WHERE batch_id = p_batch_id;
END;
$$;



(d) Trigger: trg_batches_audit [8 marks]

CREATE OR REPLACE FUNCTION fn_log_batch_change()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    IF NEW.qty_on_hand IS DISTINCT FROM OLD.qty_on_hand THEN
        INSERT INTO batch_audit (batch_id, old_qty, new_qty, changed_at)
        VALUES (NEW.batch_id, OLD.qty_on_hand, NEW.qty_on_hand, CURRENT_TIMESTAMP);
    END IF;
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_batches_audit
AFTER UPDATE ON batches
FOR EACH ROW
EXECUTE FUNCTION fn_log_batch_change();

