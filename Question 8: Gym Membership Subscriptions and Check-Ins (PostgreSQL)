(g) Scheduled Job: pr_refresh_checkins [6 marks]


CREATE OR REPLACE PROCEDURE pr_refresh_checkins(p_day DATE)
LANGUAGE plpgsql
AS $$
DECLARE
    v_count INTEGER;
BEGIN
    SELECT COUNT(*)
    INTO v_count
    FROM checkins
    WHERE checked_in_at::DATE = p_day;

    INSERT INTO daily_checkins (checkin_date, checkin_count)
    VALUES (p_day, v_count)
    ON CONFLICT (checkin_date)
    DO UPDATE SET
        checkin_count = EXCLUDED.checkin_count;
END;
$$;

-- Schedule daily at 00:10 for the previous day using pg_cron
CREATE EXTENSION IF NOT EXISTS pg_cron;

SELECT cron.schedule(
    'refresh_previous_day_checkins',
    '10 0 * * *',
    $$CALL pr_refresh_checkins((CURRENT_DATE - INTERVAL '1 day')::DATE);$$
);


