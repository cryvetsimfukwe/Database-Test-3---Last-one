Question 8: Gym Membership Subscriptions and Check-Ins (PostgreSQL)

(a) Database and Seed Data [6 marks]

CREATE TABLE members (
    member_id   SERIAL PRIMARY KEY,
    member_code VARCHAR(20) NOT NULL UNIQUE,
    full_name   VARCHAR(100) NOT NULL
);

CREATE TABLE subscriptions (
    sub_id     SERIAL PRIMARY KEY,
    member_id  INTEGER NOT NULL REFERENCES members(member_id),
    plan_name  VARCHAR(50) NOT NULL,
    start_date DATE NOT NULL,
    end_date   DATE NOT NULL CHECK (end_date >= start_date)
);

CREATE TABLE checkins (
    checkin_id   SERIAL PRIMARY KEY,
    member_id    INTEGER NOT NULL REFERENCES members(member_id),
    checked_in_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE checkin_audit (
    audit_id   SERIAL PRIMARY KEY,
    checkin_id INTEGER NOT NULL REFERENCES checkins(checkin_id),
    member_id  INTEGER NOT NULL REFERENCES members(member_id),
    logged_at  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE daily_checkins (
    checkin_date  DATE PRIMARY KEY,
    checkin_count INTEGER NOT NULL DEFAULT 0
);

