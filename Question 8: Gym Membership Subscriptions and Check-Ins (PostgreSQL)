(b) Function: fn_has_active_sub [6 marks]


CREATE OR REPLACE FUNCTION fn_has_active_sub(
    p_member_id INTEGER,
    p_on_date   DATE DEFAULT CURRENT_DATE
) RETURNS BOOLEAN
LANGUAGE plpgsql
AS $$
BEGIN
    IF p_on_date IS NULL THEN
        RAISE EXCEPTION 'Check date (p_on_date) cannot be NULL.';
    END IF;

    IF NOT EXISTS (SELECT 1 FROM members WHERE member_id = p_member_id) THEN
        RAISE EXCEPTION 'Member ID % does not exist.', p_member_id;
    END IF;

    RETURN EXISTS (
        SELECT 1
        FROM subscriptions
        WHERE member_id = p_member_id
          AND p_on_date BETWEEN start_date AND end_date
    );
END;
$$;



(c) Procedure: pr_checkin_member [8 marks]


CREATE OR REPLACE PROCEDURE pr_checkin_member(
    p_member_id     INTEGER,
    p_checked_in_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)
LANGUAGE plpgsql
AS $$
BEGIN
    IF p_checked_in_at IS NULL THEN
        RAISE EXCEPTION 'Check-in timestamp cannot be NULL.';
    END IF;

    -- Lock member row to validate existence and serialize concurrent check-ins
    PERFORM 1 FROM members WHERE member_id = p_member_id FOR UPDATE;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown member_id: %', p_member_id;
    END IF;

    IF NOT fn_has_active_sub(p_member_id, p_checked_in_at::DATE) THEN
        RAISE EXCEPTION 'Check-in denied: Member ID % does not have an active subscription on %.',
            p_member_id, p_checked_in_at::DATE;
    END IF;

    INSERT INTO checkins (member_id, checked_in_at)
    VALUES (p_member_id, p_checked_in_at);
END;
$$;



(d) Trigger: trg_checkins_audit [8 marks]


CREATE OR REPLACE FUNCTION fn_log_checkin_audit()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    INSERT INTO checkin_audit (checkin_id, member_id, logged_at)
    VALUES (NEW.checkin_id, NEW.member_id, CURRENT_TIMESTAMP);
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_checkins_audit
AFTER INSERT ON checkins
FOR EACH ROW
EXECUTE FUNCTION fn_log_checkin_audit();

