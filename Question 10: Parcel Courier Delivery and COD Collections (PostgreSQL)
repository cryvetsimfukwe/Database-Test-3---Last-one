(b) Function: fn_courier_cod_due [6 marks]

CREATE OR REPLACE FUNCTION fn_courier_cod_due(
    p_courier_id INTEGER
) RETURNS NUMERIC(12, 2)
LANGUAGE plpgsql
AS $$
DECLARE
    v_total_due NUMERIC(12, 2);
BEGIN
    IF NOT EXISTS (SELECT 1 FROM couriers WHERE courier_id = p_courier_id) THEN
        RAISE EXCEPTION 'Courier ID % does not exist.', p_courier_id;
    END IF;

    SELECT COALESCE(SUM(cod_amount), 0.00)
    INTO v_total_due
    FROM parcels
    WHERE courier_id = p_courier_id
      AND status = 'IN_TRANSIT';

    RETURN v_total_due;
END;
$$;


(c) Procedure: pr_deliver_parcel [8 marks]

CREATE OR REPLACE PROCEDURE pr_deliver_parcel(
    p_parcel_id    INTEGER,
    p_delivered_on DATE
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_status     VARCHAR(20);
    v_cod_amount NUMERIC(10, 2);
BEGIN
    IF p_delivered_on IS NULL THEN
        RAISE EXCEPTION 'Delivery date cannot be NULL.';
    END IF;

    -- Lock parcel row to prevent duplicate or concurrent deliveries
    SELECT status, cod_amount
    INTO v_status, v_cod_amount
    FROM parcels
    WHERE parcel_id = p_parcel_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown parcel_id: %', p_parcel_id;
    END IF;

    IF v_status <> 'IN_TRANSIT' THEN
        RAISE EXCEPTION 'Parcel ID % cannot be delivered (current status: %).',
            p_parcel_id, v_status;
    END IF;

    -- Mark parcel as DELIVERED
    UPDATE parcels
    SET status = 'DELIVERED',
        delivered_on = p_delivered_on
    WHERE parcel_id = p_parcel_id;

    -- Insert COD collection record only when cod_amount > 0
    IF v_cod_amount > 0 THEN
        INSERT INTO cod_collections (parcel_id, amount, collected_on)
        VALUES (p_parcel_id, v_cod_amount, p_delivered_on);
    END IF;
END;
$$;



(d) Trigger: trg_cod_parcel_guard [8 marks]

CREATE OR REPLACE FUNCTION fn_guard_cod_insert()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    v_status     VARCHAR(20);
    v_cod_amount NUMERIC(10, 2);
BEGIN
    SELECT status, cod_amount
    INTO v_status, v_cod_amount
    FROM parcels
    WHERE parcel_id = NEW.parcel_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Parcel ID % does not exist.', NEW.parcel_id;
    END IF;

    IF v_status <> 'DELIVERED' THEN
        RAISE EXCEPTION 'Cannot record COD collection for parcel ID %: status must be DELIVERED (current: %).',
            NEW.parcel_id, v_status;
    END IF;

    IF v_cod_amount <= 0 THEN
        RAISE EXCEPTION 'Cannot record COD collection for parcel ID %: parcel has no COD amount (cod_amount = %).',
            NEW.parcel_id, v_cod_amount;
    END IF;

    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_cod_parcel_guard
BEFORE INSERT ON cod_collections
FOR EACH ROW
EXECUTE FUNCTION fn_guard_cod_insert();


(e) View: v_courier_cod_due [5 marks]

CREATE OR REPLACE VIEW v_courier_cod_due AS
SELECT
    c.courier_id,
    c.courier_name,
    COUNT(p.parcel_id) AS in_transit_parcels,
    fn_courier_cod_due(c.courier_id) AS total_cod_due
FROM couriers c
LEFT JOIN parcels p
       ON p.courier_id = c.courier_id
      AND p.status = 'IN_TRANSIT'
GROUP BY c.courier_id, c.courier_name;

-- Test view before and after delivering Parcel 1 (TRK1001, COD = 450.00)
SELECT * FROM v_courier_cod_due;
CALL pr_deliver_parcel(1, CURRENT_DATE);
SELECT * FROM v_courier_cod_due; -- Chanda Mulenga's COD due drops from 450.00 to 0.00


