(g) Scheduled Job: pr_refresh_hotel_revenue [6 marks]


CREATE OR REPLACE PROCEDURE pr_refresh_hotel_revenue(p_day DATE)
LANGUAGE plpgsql
AS $$
DECLARE
    v_count   INTEGER;
    v_revenue NUMERIC(14, 2);
BEGIN
    SELECT
        COUNT(*),
        COALESCE(SUM(total_amount), 0.00)
    INTO v_count, v_revenue
    FROM invoices
    WHERE issued_at::DATE = p_day;

    INSERT INTO daily_hotel_revenue (revenue_date, checkout_count, total_revenue)
    VALUES (p_day, v_count, v_revenue)
    ON CONFLICT (revenue_date)
    DO UPDATE SET
        checkout_count = EXCLUDED.checkout_count,
        total_revenue  = EXCLUDED.total_revenue;
END;
$$;

-- Schedule daily at 01:30 for the previous day using pg_cron
CREATE EXTENSION IF NOT EXISTS pg_cron;

SELECT cron.schedule(
    'refresh_previous_day_hotel_revenue',
    '30 1 * * *',
    $$CALL pr_refresh_hotel_revenue((CURRENT_DATE - INTERVAL '1 day')::DATE);$$
);
