(g) Scheduled Job: pr_refresh_repayments [6 marks]


CREATE OR REPLACE PROCEDURE pr_refresh_repayments(p_day DATE)
LANGUAGE plpgsql
AS $$
DECLARE
    v_count INTEGER;
    v_total NUMERIC(14, 2);
BEGIN
    SELECT
        COUNT(*),
        COALESCE(SUM(amount), 0.00)
    INTO v_count, v_total
    FROM repayments
    WHERE paid_on = p_day;

    INSERT INTO daily_repayments (repayment_date, repayment_count, total_collected)
    VALUES (p_day, v_count, v_total)
    ON CONFLICT (repayment_date)
    DO UPDATE SET
        repayment_count = EXCLUDED.repayment_count,
        total_collected = EXCLUDED.total_collected;
END;
$$;

-- Schedule daily at 01:45 for the previous day using pg_cron
CREATE EXTENSION IF NOT EXISTS pg_cron;

SELECT cron.schedule(
    'refresh_previous_day_repayments',
    '45 1 * * *',
    $$CALL pr_refresh_repayments((CURRENT_DATE - INTERVAL '1 day')::DATE);$$
);
