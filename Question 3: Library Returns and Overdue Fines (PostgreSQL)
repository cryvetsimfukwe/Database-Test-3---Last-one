(b) Function: fn_overdue_fine [6 marks]

CREATE OR REPLACE FUNCTION fn_overdue_fine(
    p_loan_id     INTEGER,
    p_returned_on DATE
) RETURNS NUMERIC(10, 2)
LANGUAGE plpgsql
AS $$
DECLARE
    v_due_date   DATE;
    v_daily_fine NUMERIC(8, 2);
    v_days_late  INTEGER;
BEGIN
    IF p_returned_on IS NULL THEN
        RAISE EXCEPTION 'Return date cannot be NULL.';
    END IF;

    SELECT l.due_date, b.daily_fine
    INTO v_due_date, v_daily_fine
    FROM loans l
    JOIN books b ON b.book_id = l.book_id
    WHERE l.loan_id = p_loan_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Loan ID % does not exist.', p_loan_id;
    END IF;

    v_days_late := p_returned_on - v_due_date;

    IF v_days_late <= 0 THEN
        RETURN 0.00;
    END IF;

    RETURN v_days_late * v_daily_fine;
END;
$$;


(c) Procedure: pr_return_book [8 marks]

CREATE OR REPLACE PROCEDURE pr_return_book(
    p_loan_id     INTEGER,
    p_returned_on DATE
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_book_id     INTEGER;
    v_returned_on DATE;
    v_fine        NUMERIC(10, 2);
BEGIN
    IF p_returned_on IS NULL THEN
        RAISE EXCEPTION 'Return date cannot be NULL.';
    END IF;

    -- Lock the loan row to prevent duplicate/concurrent returns
    SELECT book_id, returned_on
    INTO v_book_id, v_returned_on
    FROM loans
    WHERE loan_id = p_loan_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown loan_id: %', p_loan_id;
    END IF;

    IF v_returned_on IS NOT NULL THEN
        RAISE EXCEPTION 'Loan ID % was already returned on %.', p_loan_id, v_returned_on;
    END IF;

    -- Calculate overdue fine before updating
    v_fine := fn_overdue_fine(p_loan_id, p_returned_on);

    -- Record return date and mark book available
    UPDATE loans
    SET returned_on = p_returned_on
    WHERE loan_id = p_loan_id;

    UPDATE books
    SET status = 'AVAILABLE'
    WHERE book_id = v_book_id;

    -- Insert fine charge only when fine > 0
    IF v_fine > 0 THEN
        INSERT INTO fine_charges (loan_id, fine_amount, created_at)
        VALUES (p_loan_id, v_fine, CURRENT_TIMESTAMP);
    END IF;
END;
$$;

(d) Trigger: trg_loans_status_guard [8 marks]

CREATE OR REPLACE FUNCTION fn_guard_book_loan_status()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    v_status VARCHAR(20);
BEGIN
    -- Only enforce availability check when creating an active (unreturned) loan
    IF NEW.returned_on IS NULL THEN
        SELECT status INTO v_status
        FROM books
        WHERE book_id = NEW.book_id
        FOR UPDATE;

        IF NOT FOUND THEN
            RAISE EXCEPTION 'Book ID % does not exist.', NEW.book_id;
        END IF;

        IF v_status <> 'AVAILABLE' THEN
            RAISE EXCEPTION 'Cannot loan book ID %: current status is % (must be AVAILABLE).',
                NEW.book_id, v_status;
        END IF;

        UPDATE books
        SET status = 'LOANED'
        WHERE book_id = NEW.book_id;
    END IF;

    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_loans_status_guard
BEFORE INSERT ON loans
FOR EACH ROW
EXECUTE FUNCTION fn_guard_book_loan_status();


(e) View: v_overdue_loans [5 marks]

CREATE OR REPLACE VIEW v_overdue_loans AS
SELECT
    l.loan_id,
    b.title,
    l.member_name,
    l.due_date,
    (CURRENT_DATE - l.due_date) AS days_overdue,
    fn_overdue_fine(l.loan_id, CURRENT_DATE) AS estimated_fine
FROM loans l
JOIN books b ON b.book_id = l.book_id
WHERE l.returned_on IS NULL
  AND l.due_date < CURRENT_DATE;

