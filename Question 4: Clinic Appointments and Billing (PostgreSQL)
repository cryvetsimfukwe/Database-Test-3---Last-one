(g) Scheduled Job: pr_refresh_billing [6 marks]

CREATE OR REPLACE PROCEDURE pr_refresh_billing(p_day DATE)
LANGUAGE plpgsql
AS $$
DECLARE
    v_count   INTEGER;
    v_revenue NUMERIC(12, 2);
BEGIN
    SELECT
        COUNT(*),
        COALESCE(SUM(total_charge), 0.00)
    INTO v_count, v_revenue
    FROM bills
    WHERE billed_at::DATE = p_day;

    INSERT INTO daily_billing (billing_date, bill_count, total_revenue)
    VALUES (p_day, v_count, v_revenue)
    ON CONFLICT (billing_date)
    DO UPDATE SET
        bill_count    = EXCLUDED.bill_count,
        total_revenue = EXCLUDED.total_revenue;
END;
$$;

-- Schedule daily at 01:15 for the previous day using pg_cron
CREATE EXTENSION IF NOT EXISTS pg_cron;

SELECT cron.schedule(
    'refresh_previous_day_billing',
    '15 1 * * *',
    $$CALL pr_refresh_billing((CURRENT_DATE - INTERVAL '1 day')::DATE);$$
);


