(b) Function: fn_bill_total [6 marks]

CREATE OR REPLACE FUNCTION fn_bill_total(
    p_appointment_id INTEGER,
    p_extra_charge   NUMERIC(10, 2) DEFAULT 0.00
) RETURNS NUMERIC(10, 2)
LANGUAGE plpgsql
AS $$
DECLARE
    v_fee NUMERIC(10, 2);
BEGIN
    IF p_extra_charge IS NULL OR p_extra_charge < 0 THEN
        RAISE EXCEPTION 'Extra charge cannot be negative or NULL (got %).', p_extra_charge;
    END IF;

    SELECT d.consultation_fee INTO v_fee
    FROM appointments a
    JOIN doctors d ON d.doctor_id = a.doctor_id
    WHERE a.appointment_id = p_appointment_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Appointment ID % does not exist.', p_appointment_id;
    END IF;

    RETURN v_fee + p_extra_charge;
END;
$$;


(c) Procedure: pr_complete_appointment [8 marks]

CREATE OR REPLACE PROCEDURE pr_complete_appointment(
    p_appointment_id INTEGER,
    p_extra_charge   NUMERIC(10, 2) DEFAULT 0.00
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_status VARCHAR(20);
    v_total  NUMERIC(10, 2);
BEGIN
    -- Lock appointment row to prevent duplicate or concurrent billing
    SELECT status INTO v_status
    FROM appointments
    WHERE appointment_id = p_appointment_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown appointment_id: %', p_appointment_id;
    END IF;

    IF v_status = 'CANCELLED' THEN
        RAISE EXCEPTION 'Appointment ID % is CANCELLED and cannot be completed or billed.', p_appointment_id;
    END IF;

    IF v_status = 'COMPLETED' THEN
        RAISE EXCEPTION 'Appointment ID % is already COMPLETED and billed.', p_appointment_id;
    END IF;

    -- Compute total (also validates p_extra_charge >= 0)
    v_total := fn_bill_total(p_appointment_id, p_extra_charge);

    -- Update appointment status and create bill atomically
    UPDATE appointments
    SET status = 'COMPLETED'
    WHERE appointment_id = p_appointment_id;

    INSERT INTO bills (appointment_id, total_charge, billed_at)
    VALUES (p_appointment_id, v_total, CURRENT_TIMESTAMP);
END;
$$;


(d) Trigger: trg_bills_appointment_guard [8 marks]

CREATE OR REPLACE FUNCTION fn_guard_bill_insert()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    v_status VARCHAR(20);
BEGIN
    SELECT status INTO v_status
    FROM appointments
    WHERE appointment_id = NEW.appointment_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Appointment ID % does not exist.', NEW.appointment_id;
    END IF;

    IF v_status <> 'COMPLETED' THEN
        RAISE EXCEPTION 'Cannot bill appointment ID %: status must be COMPLETED (current: %).',
            NEW.appointment_id, v_status;
    END IF;

    IF EXISTS (SELECT 1 FROM bills WHERE appointment_id = NEW.appointment_id) THEN
        RAISE EXCEPTION 'Appointment ID % already has a bill.', NEW.appointment_id;
    END IF;

    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_bills_appointment_guard
BEFORE INSERT ON bills
FOR EACH ROW
EXECUTE FUNCTION fn_guard_bill_insert();

