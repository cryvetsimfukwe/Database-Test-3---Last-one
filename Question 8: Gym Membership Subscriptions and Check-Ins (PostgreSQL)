(e) View: v_active_members [5 marks]


CREATE OR REPLACE VIEW v_active_members AS
SELECT
    m.member_code,
    m.full_name,
    s.plan_name,
    s.end_date
FROM members m
JOIN subscriptions s ON s.member_id = m.member_id
WHERE CURRENT_DATE BETWEEN s.start_date AND s.end_date;

