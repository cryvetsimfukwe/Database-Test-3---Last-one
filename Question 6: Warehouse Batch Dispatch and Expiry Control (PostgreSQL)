Question 6: Warehouse Batch Dispatch and Expiry Control (PostgreSQL)


(a) Database and Seed Data [6 marks]

CREATE TABLE batches (
    batch_id     SERIAL PRIMARY KEY,
    product_name VARCHAR(100) NOT NULL,
    expiry_date  DATE NOT NULL,
    qty_on_hand  INTEGER NOT NULL CHECK (qty_on_hand >= 0)
);

CREATE TABLE dispatches (
    dispatch_id   SERIAL PRIMARY KEY,
    batch_id      INTEGER NOT NULL REFERENCES batches(batch_id),
    qty_dispatched INTEGER NOT NULL CHECK (qty_dispatched > 0),
    dispatched_on DATE NOT NULL DEFAULT CURRENT_DATE
);

CREATE TABLE batch_audit (
    audit_id   SERIAL PRIMARY KEY,
    batch_id   INTEGER NOT NULL REFERENCES batches(batch_id),
    old_qty    INTEGER NOT NULL,
    new_qty    INTEGER NOT NULL,
    changed_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE daily_dispatches (
    dispatch_date  DATE PRIMARY KEY,
    dispatch_count INTEGER NOT NULL DEFAULT 0,
    total_qty      INTEGER NOT NULL DEFAULT 0
);

