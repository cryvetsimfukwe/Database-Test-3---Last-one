(e) View: v_open_loans [5 marks]

CREATE OR REPLACE VIEW v_open_loans AS
SELECT
    loan_id,
    borrower_name,
    principal,
    (principal - fn_loan_balance(loan_id)) AS total_repaid,
    fn_loan_balance(loan_id)               AS remaining_balance
FROM loan_accounts
WHERE status = 'OPEN';

