(b) Function: fn_fuel_sale_total [6 marks]

CREATE OR REPLACE FUNCTION fn_fuel_sale_total(
    p_tank_id INTEGER,
    p_litres  NUMERIC(10, 2)
) RETURNS NUMERIC(14, 2)
LANGUAGE plpgsql
AS $$
DECLARE
    v_price NUMERIC(10, 2);
BEGIN
    IF p_litres IS NULL OR p_litres <= 0 THEN
        RAISE EXCEPTION 'Invalid litres: %. Quantity must be positive.', p_litres;
    END IF;

    SELECT price_per_litre INTO v_price
    FROM tanks
    WHERE tank_id = p_tank_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Tank ID % does not exist.', p_tank_id;
    END IF;

    RETURN ROUND(v_price * p_litres, 2);
END;
$$;

(c) Procedure: pr_record_pump_sale [8 marks]

CREATE OR REPLACE PROCEDURE pr_record_pump_sale(
    p_tank_id INTEGER,
    p_litres  NUMERIC(10, 2),
    p_sold_on DATE
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_price          NUMERIC(10, 2);
    v_current_litres NUMERIC(12, 2);
BEGIN
    IF p_litres IS NULL OR p_litres <= 0 THEN
        RAISE EXCEPTION 'Litres sold must be greater than zero.';
    END IF;

    IF p_sold_on IS NULL THEN
        RAISE EXCEPTION 'Sale date cannot be NULL.';
    END IF;

    -- Lock tank row to prevent concurrent over-dispensing
    SELECT price_per_litre, current_litres
    INTO v_price, v_current_litres
    FROM tanks
    WHERE tank_id = p_tank_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown tank_id: %', p_tank_id;
    END IF;

    IF v_current_litres < p_litres THEN
        RAISE EXCEPTION 'Insufficient fuel in tank_id %. Available: % L, Requested: % L',
            p_tank_id, v_current_litres, p_litres;
    END IF;

    -- Insert pump sale using current tank price
    INSERT INTO pump_sales (tank_id, litres, price_per_litre, sold_on)
    VALUES (p_tank_id, p_litres, v_price, p_sold_on);

    -- Deduct dispensed litres once
    UPDATE tanks
    SET current_litres = current_litres - p_litres
    WHERE tank_id = p_tank_id;
END;
$$;

(d) Trigger: trg_tanks_audit [8 marks]

CREATE OR REPLACE FUNCTION fn_log_tank_change()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    IF NEW.current_litres IS DISTINCT FROM OLD.current_litres THEN
        INSERT INTO tank_audit (tank_id, old_litres, new_litres, changed_at)
        VALUES (NEW.tank_id, OLD.current_litres, NEW.current_litres, CURRENT_TIMESTAMP);
    END IF;
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_tanks_audit
AFTER UPDATE ON tanks
FOR EACH ROW
EXECUTE FUNCTION fn_log_tank_change();

