(g) Scheduled Job: pr_refresh_dispatches [6 marks]

CREATE OR REPLACE PROCEDURE pr_refresh_dispatches(p_day DATE)
LANGUAGE plpgsql
AS $$
DECLARE
    v_count INTEGER;
    v_qty   INTEGER;
BEGIN
    SELECT
        COUNT(*),
        COALESCE(SUM(qty_dispatched), 0)
    INTO v_count, v_qty
    FROM dispatches
    WHERE dispatched_on = p_day;

    INSERT INTO daily_dispatches (dispatch_date, dispatch_count, total_qty)
    VALUES (p_day, v_count, v_qty)
    ON CONFLICT (dispatch_date)
    DO UPDATE SET
        dispatch_count = EXCLUDED.dispatch_count,
        total_qty      = EXCLUDED.total_qty;
END;
$$;

-- Schedule daily at 00:40 for the previous day using pg_cron
CREATE EXTENSION IF NOT EXISTS pg_cron;

SELECT cron.schedule(
    'refresh_previous_day_dispatches',
    '40 0 * * *',
    $$CALL pr_refresh_dispatches((CURRENT_DATE - INTERVAL '1 day')::DATE);$$
);
