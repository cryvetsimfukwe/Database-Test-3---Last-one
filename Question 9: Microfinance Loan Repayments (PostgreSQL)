Question 9: Microfinance Loan Repayments (PostgreSQL)


(a) Database and Seed Data [6 marks]

CREATE TABLE loan_accounts (
    loan_id       SERIAL PRIMARY KEY,
    borrower_name VARCHAR(100) NOT NULL,
    principal     NUMERIC(12, 2) NOT NULL CHECK (principal > 0),
    status        VARCHAR(20) NOT NULL DEFAULT 'OPEN'
                  CHECK (status IN ('OPEN', 'SETTLED'))
);

CREATE TABLE repayments (
    repayment_id SERIAL PRIMARY KEY,
    loan_id      INTEGER NOT NULL REFERENCES loan_accounts(loan_id),
    amount       NUMERIC(12, 2) NOT NULL CHECK (amount > 0),
    paid_on      DATE NOT NULL DEFAULT CURRENT_DATE
);

CREATE TABLE repayment_audit (
    audit_id     SERIAL PRIMARY KEY,
    repayment_id INTEGER NOT NULL REFERENCES repayments(repayment_id),
    loan_id      INTEGER NOT NULL REFERENCES loan_accounts(loan_id),
    amount       NUMERIC(12, 2) NOT NULL,
    logged_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE daily_repayments (
    repayment_date  DATE PRIMARY KEY,
    repayment_count INTEGER NOT NULL DEFAULT 0,
    total_collected NUMERIC(14, 2) NOT NULL DEFAULT 0.00
);

