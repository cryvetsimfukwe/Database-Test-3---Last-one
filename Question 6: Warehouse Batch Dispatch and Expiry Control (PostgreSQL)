CALL pr_dispatch_batch(4, 30, CURRENT_DATE);



(e) View: v_expiring_batches [5 marks]

CREATE OR REPLACE VIEW v_expiring_batches AS
SELECT
    batch_id,
    product_name,
    expiry_date,
    qty_on_hand,
    fn_days_to_expiry(batch_id, CURRENT_DATE) AS days_remaining
FROM batches
WHERE qty_on_hand > 0
  AND fn_days_to_expiry(batch_id, CURRENT_DATE) BETWEEN 0 AND 14;

