(e) View: v_doctor_billing [5 marks]

CREATE OR REPLACE VIEW v_doctor_billing AS
SELECT
    d.doctor_id,
    d.doctor_name,
    d.specialty,
    COUNT(b.bill_id) AS completed_appointments,
    COALESCE(SUM(b.total_charge), 0.00) AS total_billed_revenue
FROM doctors d
LEFT JOIN appointments a
       ON a.doctor_id = d.doctor_id
      AND a.status = 'COMPLETED'
LEFT JOIN bills b
       ON b.appointment_id = a.appointment_id
GROUP BY d.doctor_id, d.doctor_name, d.specialty;

