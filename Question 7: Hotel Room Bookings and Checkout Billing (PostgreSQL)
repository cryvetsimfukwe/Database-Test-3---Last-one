Question 7: Hotel Room Bookings and Checkout Billing (PostgreSQL)


(a) Database and Seed Data [6 marks]

CREATE TABLE rooms (
    room_id      SERIAL PRIMARY KEY,
    room_number  VARCHAR(10) NOT NULL UNIQUE,
    nightly_rate NUMERIC(10, 2) NOT NULL CHECK (nightly_rate > 0),
    status       VARCHAR(20) NOT NULL DEFAULT 'AVAILABLE'
                 CHECK (status IN ('AVAILABLE', 'OCCUPIED'))
);

CREATE TABLE bookings (
    booking_id SERIAL PRIMARY KEY,
    room_id    INTEGER NOT NULL REFERENCES rooms(room_id),
    guest_name VARCHAR(100) NOT NULL,
    check_in   DATE NOT NULL,
    check_out  DATE NOT NULL CHECK (check_out > check_in),
    status     VARCHAR(20) NOT NULL DEFAULT 'CHECKED_IN'
               CHECK (status IN ('CHECKED_IN', 'CHECKED_OUT'))
);

CREATE TABLE invoices (
    invoice_id   SERIAL PRIMARY KEY,
    booking_id   INTEGER NOT NULL UNIQUE REFERENCES bookings(booking_id),
    total_amount NUMERIC(12, 2) NOT NULL CHECK (total_amount >= 0),
    issued_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE daily_hotel_revenue (
    revenue_date  DATE PRIMARY KEY,
    checkout_count INTEGER NOT NULL DEFAULT 0,
    total_revenue NUMERIC(14, 2) NOT NULL DEFAULT 0.00
);

