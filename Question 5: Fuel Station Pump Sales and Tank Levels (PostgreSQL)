Question 5: Fuel Station Pump Sales and Tank Levels (PostgreSQL)


(a) Database and Seed Data [6 marks]

CREATE TABLE tanks (
    tank_id         SERIAL PRIMARY KEY,
    fuel_type       VARCHAR(30) NOT NULL UNIQUE,
    price_per_litre NUMERIC(10, 2) NOT NULL CHECK (price_per_litre > 0),
    current_litres  NUMERIC(12, 2) NOT NULL CHECK (current_litres >= 0)
);

CREATE TABLE pump_sales (
    sale_id         SERIAL PRIMARY KEY,
    tank_id         INTEGER NOT NULL REFERENCES tanks(tank_id),
    litres          NUMERIC(10, 2) NOT NULL CHECK (litres > 0),
    price_per_litre NUMERIC(10, 2) NOT NULL CHECK (price_per_litre > 0),
    sold_on         DATE NOT NULL DEFAULT CURRENT_DATE
);

CREATE TABLE tank_audit (
    audit_id   SERIAL PRIMARY KEY,
    tank_id    INTEGER NOT NULL REFERENCES tanks(tank_id),
    old_litres NUMERIC(12, 2) NOT NULL,
    new_litres NUMERIC(12, 2) NOT NULL,
    changed_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE daily_fuel_sales (
    sales_date   DATE PRIMARY KEY,
    total_litres NUMERIC(12, 2) NOT NULL DEFAULT 0.00,
    total_amount NUMERIC(14, 2) NOT NULL DEFAULT 0.00
);

