(g) Scheduled Job: pr_refresh_fuel_sales [6 marks]

CREATE OR REPLACE PROCEDURE pr_refresh_fuel_sales(p_day DATE)
LANGUAGE plpgsql
AS $$
DECLARE
    v_litres NUMERIC(12, 2);
    v_amount NUMERIC(14, 2);
BEGIN
    SELECT
        COALESCE(SUM(litres), 0.00),
        COALESCE(SUM(litres * price_per_litre), 0.00)
    INTO v_litres, v_amount
    FROM pump_sales
    WHERE sold_on = p_day;

    INSERT INTO daily_fuel_sales (sales_date, total_litres, total_amount)
    VALUES (p_day, v_litres, v_amount)
    ON CONFLICT (sales_date)
    DO UPDATE SET
        total_litres = EXCLUDED.total_litres,
        total_amount = EXCLUDED.total_amount;
END;
$$;

-- Schedule daily at 00:20 for the previous day using pg_cron
CREATE EXTENSION IF NOT EXISTS pg_cron;

SELECT cron.schedule(
    'refresh_previous_day_fuel_sales',
    '20 0 * * *',
    $$CALL pr_refresh_fuel_sales((CURRENT_DATE - INTERVAL '1 day')::DATE);$$
);
