(b) Function: fn_stay_cost [6 marks]

CREATE OR REPLACE FUNCTION fn_stay_cost(
    p_booking_id INTEGER
) RETURNS NUMERIC(12, 2)
LANGUAGE plpgsql
AS $$
DECLARE
    v_nights       INTEGER;
    v_nightly_rate NUMERIC(10, 2);
BEGIN
    SELECT (b.check_out - b.check_in), r.nightly_rate
    INTO v_nights, v_nightly_rate
    FROM bookings b
    JOIN rooms r ON r.room_id = b.room_id
    WHERE b.booking_id = p_booking_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Booking ID % does not exist.', p_booking_id;
    END IF;

    IF v_nights IS NULL OR v_nights <= 0 THEN
        RAISE EXCEPTION 'Invalid stay length (% nights) for booking ID %.', v_nights, p_booking_id;
    END IF;

    RETURN v_nights * v_nightly_rate;
END;
$$;


(c) Procedure: pr_checkout_booking [8 marks]

CREATE OR REPLACE PROCEDURE pr_checkout_booking(
    p_booking_id INTEGER
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_room_id INTEGER;
    v_status  VARCHAR(20);
    v_total   NUMERIC(12, 2);
BEGIN
    -- Lock booking row to prevent duplicate or concurrent checkouts
    SELECT room_id, status
    INTO v_room_id, v_status
    FROM bookings
    WHERE booking_id = p_booking_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown booking_id: %', p_booking_id;
    END IF;

    IF v_status <> 'CHECKED_IN' THEN
        RAISE EXCEPTION 'Booking ID % cannot be checked out (current status: %).',
            p_booking_id, v_status;
    END IF;

    v_total := fn_stay_cost(p_booking_id);

    -- Mark booking checked out and free the room
    UPDATE bookings
    SET status = 'CHECKED_OUT'
    WHERE booking_id = p_booking_id;

    UPDATE rooms
    SET status = 'AVAILABLE'
    WHERE room_id = v_room_id;

    -- Issue single invoice
    INSERT INTO invoices (booking_id, total_amount, issued_at)
    VALUES (p_booking_id, v_total, CURRENT_TIMESTAMP);
END;
$$;

(d) Trigger: trg_bookings_room_guard [8 marks]

CREATE OR REPLACE FUNCTION fn_guard_booking_room()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    v_room_status VARCHAR(20);
BEGIN
    IF NEW.status = 'CHECKED_IN' THEN
        SELECT status INTO v_room_status
        FROM rooms
        WHERE room_id = NEW.room_id
        FOR UPDATE;

        IF NOT FOUND THEN
            RAISE EXCEPTION 'Room ID % does not exist.', NEW.room_id;
        END IF;

        IF v_room_status <> 'AVAILABLE' THEN
            RAISE EXCEPTION 'Cannot check in to room ID %: room is currently %.',
                NEW.room_id, v_room_status;
        END IF;

        UPDATE rooms
        SET status = 'OCCUPIED'
        WHERE room_id = NEW.room_id;
    END IF;

    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_bookings_room_guard
BEFORE INSERT ON bookings
FOR EACH ROW
EXECUTE FUNCTION fn_guard_booking_room();


