(g) Scheduled Job: pr_refresh_fines [6 marks]

CREATE OR REPLACE PROCEDURE pr_refresh_fines(p_day DATE)
LANGUAGE plpgsql
AS $$
DECLARE
    v_count INTEGER;
    v_total NUMERIC(12, 2);
BEGIN
    SELECT
        COUNT(*),
        COALESCE(SUM(fine_amount), 0.00)
    INTO v_count, v_total
    FROM fine_charges
    WHERE created_at::DATE = p_day;

    INSERT INTO daily_fines (fine_date, fine_count, total_fines)
    VALUES (p_day, v_count, v_total)
    ON CONFLICT (fine_date)
    DO UPDATE SET
        fine_count  = EXCLUDED.fine_count,
        total_fines = EXCLUDED.total_fines;
END;
$$;

-- Schedule daily at 00:30 for the previous day using pg_cron
CREATE EXTENSION IF NOT EXISTS pg_cron;

SELECT cron.schedule(
    'refresh_previous_day_fines',
    '30 0 * * *',
    $$CALL pr_refresh_fines((CURRENT_DATE - INTERVAL '1 day')::DATE);$$
);
