Question 3: Library Returns and Overdue Fines (PostgreSQL)

(a) Database and Seed Data [6 marks]

CREATE TABLE books (
    book_id    SERIAL PRIMARY KEY,
    title      VARCHAR(150) NOT NULL,
    daily_fine NUMERIC(8, 2) NOT NULL CHECK (daily_fine > 0),
    status     VARCHAR(20) NOT NULL DEFAULT 'AVAILABLE'
               CHECK (status IN ('AVAILABLE', 'LOANED'))
);

CREATE TABLE loans (
    loan_id     SERIAL PRIMARY KEY,
    book_id     INTEGER NOT NULL REFERENCES books(book_id),
    member_name VARCHAR(100) NOT NULL,
    due_date    DATE NOT NULL,
    returned_on DATE NULL
);

CREATE TABLE fine_charges (
    charge_id   SERIAL PRIMARY KEY,
    loan_id     INTEGER NOT NULL UNIQUE REFERENCES loans(loan_id),
    fine_amount NUMERIC(10, 2) NOT NULL CHECK (fine_amount >= 0),
    created_at  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE daily_fines (
    fine_date   DATE PRIMARY KEY,
    fine_count  INTEGER NOT NULL DEFAULT 0,
    total_fines NUMERIC(12, 2) NOT NULL DEFAULT 0.00
);

